# Reference template only. Spring Boot does not automatically load .env files.
# Inject these through the deployment environment/secret manager. Replace every placeholder.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
# Required: cryptographically random secret, at least 32 bytes. Blank deliberately prevents prod startup.
JWT_SECRET=
JWT_MINUTES=60
APP_ORIGINS=https://hrms.example.com
ADMIN_EMAIL=admin@example.com
# Required: unique password, 12+ characters and at most 72 UTF-8 bytes.
ADMIN_PASSWORD=
ADMIN_NAME=Admin
MYSQL_URL=jdbc:mysql://db.example.com:3306/xpertsedgehrms?sslMode=VERIFY_IDENTITY&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
MYSQL_USERNAME=hrms_app
MYSQL_PASSWORD=
LOG_DIR=./logs

# MailerSend production mail transport. Keep real values only in the deployment secret manager.
HRMS_MAIL_DOMAIN=xpertsedgetech.com
MAILERSEND_API_TOKEN=
MAILERSEND_INBOUND_DOMAIN=inbound.xpertsedgetech.com
MAILERSEND_INBOUND_SIGNING_SECRET=
MAILERSEND_EVENTS_SIGNING_SECRET=


# Optional Gmail outbound (local development only; see GMAIL-SMTP.md)
# GMAIL_SMTP_USERNAME=
# GMAIL_SMTP_APP_PASSWORD=
# GMAIL_ALLOWED_MAILBOXES=

# Optional Gmail API + OAuth (send and receive; see GMAIL-OAUTH.md). Enable with the gmail-api Spring profile.
# GOOGLE_CLIENT_ID=<web client id>.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8080/api/webmail/gmail/callback
# Existing local Webmail mailbox allowed to administer the one shared company Gmail connection.
# GMAIL_COMPANY_ADMIN_MAILBOX=admin@xpertsedge.com
# Optional: base64 of 32 random bytes to encrypt stored Gmail refresh tokens; blank derives a key from the app signing secret.
# GMAIL_TOKEN_KEY=
